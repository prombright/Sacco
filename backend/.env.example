# Copy to backend/.env and fill in. backend/.env is never committed.

APP_ENV=local
# true shows real error messages in API replies - never true on the live server
APP_DEBUG=true
APP_TIMEZONE=Africa/Kampala

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=

# The database holding the list of SACCOs on this installation. With one SACCO, use the SACCO's
# own database here too (create it with --db set to the same name, see bin/create-sacco.php), so
# everything lives in one database. Further SACCOs can each have their own.
PLATFORM_DB_NAME=sacco_smacon

# The SACCO the login page shows when the web address doesn't pick one
DEFAULT_SACCO_CODE=smacon

# Signed out after this long without activity
SESSION_IDLE_MINUTES=30

# Optional: only these internet addresses (comma separated) can reach the developer portal
DEV_ALLOWED_IPS=

# The app's own address, for links in emails (no slash at the end)
APP_URL=http://localhost/sacco

# Email copies of members' messages and password reset links.
# MAIL_DRIVER: smtp (a mailbox's server), mail (PHP mail(), works on most cPanel hosts),
# log (writes them to backend/storage/mail/ instead of sending; the default here) or off
MAIL_DRIVER=log
MAIL_HOST=
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
