# Serves the app from one folder (locally http://localhost/sacco/, or a domain's document root):
# /api/...      -> the PHP API (backend/public/index.php)
# /assets/...   -> the built Vue app's files in frontend/dist (and /brand/... its pictures)
# anything else -> the Vue app's page (run `npm run build` in frontend/ first)

RewriteEngine On

# Always HTTPS on the live server (money and passwords travel here); not on localhost
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

RewriteRule ^api(/.*)?$ backend/public/index.php [QSA,L]
RewriteRule ^(assets/.+|brand/.+|favicon\.svg)$ frontend/dist/$1 [L]
RewriteRule ^(?!frontend/dist/|backend/public/) frontend/dist/index.html [L]

# Security headers on the app's pages (the API sets its own in backend/public/index.php)
<IfModule mod_headers.c>
  <If "! %{REQUEST_FILENAME} =~ m#/backend/public/#">
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "same-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
  </If>
  # The page itself is always checked for a newer version; its files have unique names
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
